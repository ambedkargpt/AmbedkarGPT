# syntax=docker/dockerfile:1.7
# ─────────────────────────────────────────────────────────────────────────────
# Dockerfile.radio
#
# AWS Batch container for Bhim Radio's rolling bulletin
# (backend/worker/radio_live). The schedule starts it every few minutes; it
# checks whether the last two days' stories have changed and, when they have,
# rebuilds the bulletin with the newest story first and puts it on air. When
# nothing has changed it exits after one database read.
#
# Why a separate image: bheem-radio needs openai>=3.0 and google-genai>=2.25,
# and this project pins openai==1.61.1 and google-genai==1.29.0. pip cannot
# satisfy both in one environment, so the radio gets its own. It is also much
# smaller than the worker: no yt-dlp, no torch. Text in, audio out.
#
# The engine lives in a private repository. Its token is passed as a BuildKit
# secret, so it is used to clone during the build and is never written into a
# layer of the image:
#
#   docker build -f Dockerfile.radio \
#     --secret id=bheem_radio_token,env=BHEEM_RADIO_TOKEN \
#     -t ambedkargpt-radio:local .
#
# Batch: 1 vCPU, 2 GB, 90 min timeout (a cold first build voices every line;
# later builds reuse the voice cache kept in the bucket).
# ─────────────────────────────────────────────────────────────────────────────

FROM python:3.11-slim-bookworm

LABEL org.opencontainers.image.title="ambedkargpt-radio" \
      org.opencontainers.image.description="Bhim Radio rolling bulletin build (AWS Batch)"

# ffmpeg mixes and encodes the stream; git installs bheem-radio, which has no
# PyPI release.
RUN apt-get update && \
    apt-get install -y --no-install-recommends ffmpeg git ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Pinned to a commit, so an upstream push cannot change tonight's bulletin.
ARG BHEEM_RADIO_REF=32289f8a25b3f9be09ac817aec4458af873b6864

# The engine, its prompts and its composed music (story bed, outro bed,
# stinger), which a script in the repository renders at build time.
RUN --mount=type=secret,id=bheem_radio_token,required=true \
    TOKEN="$(cat /run/secrets/bheem_radio_token)" && \
    REPO="https://x-access-token:${TOKEN}@github.com/smartbhaujan/BHEEM-RADIO.git" && \
    pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir "bheem-radio[mongo] @ git+${REPO}@${BHEEM_RADIO_REF}" && \
    git clone --quiet "${REPO}" /tmp/bheem && \
    cd /tmp/bheem && git checkout -q "${BHEEM_RADIO_REF}" && \
    pip install --no-cache-dir "numpy>=1.26" "scipy>=1.11" && \
    python scripts/compose_news_music.py && \
    pip uninstall -y numpy scipy && \
    mkdir -p /opt/bheem-radio && \
    cp -r /tmp/bheem/assets /tmp/bheem/prompts /opt/bheem-radio/ && \
    rm -rf /tmp/bheem

# Our side: the engine settings, the agreed prompts and anchor lines, the
# theme, the headline bed and the produced ads, and the bulletin build itself.
COPY backend/__init__.py               /app/backend/__init__.py
COPY backend/worker/__init__.py        /app/backend/worker/__init__.py
COPY backend/worker/build_radio.py     /app/backend/worker/build_radio.py
COPY backend/worker/radio_prompts      /app/backend/worker/radio_prompts
COPY backend/worker/radio_assets/music /app/backend/worker/radio_assets/music
COPY backend/worker/radio_live         /app/backend/worker/radio_live

RUN mkdir -p /tmp/bheem-radio

ENV BHEEM_ASSETS_DIR=/opt/bheem-radio/assets \
    BHEEM_PROMPTS_DIR=/opt/bheem-radio/prompts \
    BHEEM_DATA_DIR=/tmp/bheem-radio \
    PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1

# Fail the image build, not a run at three in the morning, if any of this is
# missing.
RUN python -c "import bheem_radio, backend.worker.build_radio, backend.worker.radio_live.build, backend.worker.radio_live.publish; print('imports ok')" && \
    ffmpeg -version > /dev/null && \
    test -s /opt/bheem-radio/assets/music/story_bed.wav && \
    test -s /app/backend/worker/radio_assets/music/ad_social.wav && \
    test -s /app/backend/worker/radio_live/prompts/writer.txt

ENTRYPOINT ["python", "-m", "backend.worker.radio_live"]
