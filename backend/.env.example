# =============================================================================
# backend/.env — copy this file to backend/.env and fill in the values.
#
# Nothing here is secret; backend/.env is gitignored and this file is not.
# Anything marked REQUIRED has no working default: the app starts without it
# and then fails at the first request that needs it.
# =============================================================================

# ── Database (REQUIRED) ───────────────────────────────────────────────────────
MONGODB_URI=<paste your Atlas URI here>
MONGODB_DATABASE=ambedkargpt

# ── JWT (REQUIRED) ────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRY_MINUTES=30
REFRESH_TOKEN_EXPIRY_DAYS=7

# ── Post generation (REQUIRED) ────────────────────────────────────────────────
# DeepSeek writes the posts and runs the research step.
DEEPSEEK_API_KEY=<your DeepSeek key>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-reasoner
# Writing is instruction-following, not deduction. On a reasoning model the
# chain-of-thought consumed the whole completion budget and returned an empty
# post; deepseek-chat does the same job in about a tenth of the time.
POST_GENERATION_MODEL=deepseek-chat
RESEARCH_MODEL=deepseek-chat

# ── Retrieval (REQUIRED) ──────────────────────────────────────────────────────
# Gemini embeds the query, Pinecone stores the chunks. Retrieval failure is not
# degraded past silently: the API returns 503 rather than an ungrounded post.
GEMINI_API_KEY=<your Gemini key>
EMBEDDING_MODEL=gemini-embedding-001
PINECONE_API_KEY=<your Pinecone key>
PINECONE_INDEX_NAME=ambedkargpt

# ── Ambedkar-SemRAG Memgraph Knowledge Graph (Optional / Recommended) ─────────
# BheemBot's book passages and their book-and-page references come ONLY from here: without a
# working connection it still answers, but from transcripts, and no reference is ever shown.
# Use bolt+s://host:7687 for Memgraph Cloud (bolt+ssc:// is tried automatically if its
# certificate is self-signed); bolt://localhost:7687 for a local instance.
# On AWS Lambda these are NOT read from this file: set all three as environment variables on
# the function (the deploy workflow only ships code). Check with: GET /api/v1/health/semrag
# (connected: true) after a deploy. NEO4J_URI / NEO4J_USERNAME / NEO4J_PASSWORD also work.
MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_USERNAME=
MEMGRAPH_PASSWORD=


# ── Web research (optional, off by default) ───────────────────────────────────
# Grounds posts in searched sources. Needs a reachable SearXNG:
#   docker compose -f deploy/searxng/docker-compose.yml up -d
# Unset, posts are written from the model and the transcript alone. Set, each
# post's checkable claims are searched first and the findings go into the
# prompt, so the post has something under it besides the model.
#
# Researching inline took about twenty seconds and pushed generation past the
# thirty the HTTP API in front of the Lambda allows: the browser got a 503
# while the Lambda finished the post and logged a 200. Thirty seconds is a hard
# ceiling there and cannot be raised.
#
# So the research moved off the request path. It is the same work for every
# post written from the same story, so it is done once per story and stored on
# the news document:
#
#     python -m backend.scripts.research_recent_news --apply
#
# and the API reads it from there, which costs nothing.
WEB_RESEARCH_ENABLED=1

# Whether the API may research on the spot, or only use a brief prepared
# earlier. Leave this on: it is what keeps generation inside the gateway's
# thirty seconds. A story with no brief yet is written without research rather
# than timing out, and the next run of the script has one ready for next time.
# The script turns it off for itself.
WEB_RESEARCH_PRECOMPUTED_ONLY=1
# Which search backend to use:
#   auto    walk searxng -> ddg, taking the first that answers
#   searxng SearXNG only, pinned
#   ddg     DuckDuckGo only, pinned
#
# auto is what production should run. A backend that is unreachable is stepped
# over, and DuckDuckGo sits last because it needs neither key nor quota, so
# search never simply stops. A laptop with the container running gets SearXNG
# and its Google results; the Lambda has no container, so the same setting
# lands on DuckDuckGo - verified answering from an AWS address, which is not a
# given, since YouTube refuses the same IPs outright.
SEARCH_PROVIDER=auto
SEARXNG_URL=http://localhost:8080

# Google Programmable Search is NOT in the auto chain. It can no longer be set
# to search the entire web, so a new engine covers only the sites listed on it.
# Set these and SEARCH_PROVIDER=google only if you want that curated behaviour,
# or hold an older engine that kept the entire-web setting.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# How long a backend stays skipped after answering 429, so a long-running
# process picks it back up after the daily reset without a restart.
SEARCH_QUOTA_RETRY_SECONDS=1800
# Only for a SearXNG reachable from the internet, where an ALB rule demands
# this header. Leave empty for a local container.
SEARXNG_AUTH_TOKEN=
# Reading pages needs trafilatura. Without it every source silently degrades to
# a one-line search snippet while the logs still report sources as verified:
#   pip install trafilatura
POST_VALIDATION_ENABLED=true

# ── Contact form email (REQUIRED for the landing form) ────────────────────────
# Gmail with an App Password, NOT the account password. Generate one at
# Google Account > Security > App passwords; 2-Step Verification must be on
# first or the option does not appear.
#
# Do not point this at a capture-only host such as sandbox.smtp.mailtrap.io:
# it accepts mail, shows it in a web UI, and never delivers. Verify with
#   python -m backend.scripts.check_contact_email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<the gmail address you send from>
SMTP_PASSWORD=<16-character app password, no spaces>
# Gmail rewrites From to the authenticated account, so keep the same address.
# A display name is fine: "AmbedkarGPT Contact Form <you@gmail.com>"
CONTACT_FROM_EMAIL=<same address as SMTP_USER>
CONTACT_RECIPIENT_EMAIL=<where contact submissions should land>

# ── Auth extras ───────────────────────────────────────────────────────────────
# Sign-in verifies the ID token client-side, so only the ID is needed. The
# client secret this file used to ask for is read nowhere in the backend.
GOOGLE_CLIENT_ID=<your Google OAuth client ID>
# SMS OTP provider. The Twilio keys this file used to list are no longer read.
TWOFACTOR_API_KEY=<your 2Factor API key>
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ── News ingestion ────────────────────────────────────────────────────────────
NEWS_API_KEY=<your NewsAPI key>
NEWS_COUNTRY=in
NEWS_PAGE_SIZE=20

# ── Web server ────────────────────────────────────────────────────────────────
# Comma separated. Unset falls back to '*', which is fine locally and not in
# production.
CORS_ORIGINS=http://localhost:5173
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# ── Dev helpers ───────────────────────────────────────────────────────────────
# Returns the OTP in the API response so signup works without SMS credentials.
# Never enable outside development.
AUTH_DEBUG_RETURN_OTP=true
# Writes every research run's prompts, results and pages to disk for inspection.
WEB_RESEARCH_DEBUG_DIR=
# Password for the shared team accounts created by
# backend/scripts/seed_test_accounts.py. Those accounts have no generation or
# publishing limits, so keep this out of the repository and share it directly.
TEST_ACCOUNT_PASSWORD=

# ── Publishing to Reddit ─────────────────────────────────────────────────────
# Unset, the publish sheet hides Reddit and the Preferences panel does not
# appear: the API reports configured=false and the UI believes it. Nothing here
# is needed to run the app.
#
# Create a *web app* at https://www.reddit.com/prefs/apps (not "script" - only
# a web app can send a user through the consent screen), with the redirect URI
# below set to exactly the same string.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=https://api.example.com/api/v1/integrations/reddit/callback

# The one community posts may go to. Validated against Reddit's own rule for a
# name, so a typo stops publishing rather than sending posts somewhere else.
REDDIT_SUBREDDIT=ambedkargpt

# Reddit rate-limits generic user agents hard and asks that this identify the
# app and its author.
REDDIT_USER_AGENT=web:ambedkargpt:v1.0 (by /u/your-reddit-username)

# Encrypts the stored refresh tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it means every user has to reconnect; changing it means the same.
INTEGRATION_TOKEN_KEY=

# Where the Reddit callback sends the browser back to. Falls back to the first
# non-wildcard CORS_ORIGINS entry, then to http://localhost:5173.
FRONTEND_BASE_URL=https://app.example.com
